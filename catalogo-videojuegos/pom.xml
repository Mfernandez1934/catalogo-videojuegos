<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.entregable4</groupId>
    <artifactId>catalogo-videojuegos</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Catalogo de Videojuegos (padre)</name>

    <modules>
        <module>juegos</module>
        <module>catalogo</module>
        <module>web</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Permite correr SOLO las pruebas de integracion: mvn verify -DskipUTs=true -->
        <skipUTs>false</skipUTs>
    </properties>

    <!-- Dependencias de prueba comunes a todos los modulos (JUnit 5, Mockito, AssertJ, MockMvc) -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.entregable4</groupId>
                <artifactId>juegos</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.entregable4</groupId>
                <artifactId>catalogo</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Pruebas unitarias: clases *Test -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <skipTests>${skipUTs}</skipTests>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
